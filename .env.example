# Copy to .env (setup does this) and adjust per machine. Real environment variables win.
# Format: BAYN_<SECTION>__<KEY>=value  (see config/default.yaml for every option)

# EEG source: sim | muse | lsl   (the real Muse becomes the default in Phase 2)
BAYN_EEG__SOURCE=sim

# Mains notch: auto | 50 | 60 | off   (auto = notch both, report the measured one)
BAYN_EEG__NOTCH_HZ=auto

# Muse 2 name if several headsets are around, e.g. Muse-1A2B
# BAYN_EEG__BRAINFLOW__SERIAL_NUMBER=

# Dashboard
BAYN_UI__PORT=8080
# BAYN_UI__OPEN_BROWSER=false

# BAYN_LOGGING__LEVEL=DEBUG
